{
  "name": "agentgate",
  "version": "0.1.0",
  "description": "MCP gateway for AI agents: OAuth 2.1, least-privilege tool bundles, credential vault, sandboxed servers, data-flow guard and tamper-evident audit logs on CockroachDB.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node --import tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/seed.ts",
    "redteam": "tsx eval/redteam.ts",
    "build:web": "npm --prefix web run build",
    "ci": "npm run typecheck && npm test"
  },
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "hono": "^4.13.14",
    "jose": "^6.2.13",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
